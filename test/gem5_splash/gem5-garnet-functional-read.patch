@@ -642,6 +642,19 @@ GarnetNetwork::functionalRead(Packet *pkt, WriteMask &mask)
     return read;
 }
 
+bool GarnetNetwork::s_unmaskedRead = false;
+
+bool
+GarnetNetwork::functionalRead(Packet *pkt)
+{
+    WriteMask mask;
+    mask.setBlockSize(getRubySystem()->getBlockSizeBytes());
+    s_unmaskedRead = true;
+    bool read = functionalRead(pkt, mask);
+    s_unmaskedRead = false;
+    return read;
+}
+
 uint32_t
 GarnetNetwork::functionalWrite(Packet *pkt)
 {
