<!--Cache Simulator Global Configuration Parameters
  Cache2Cache = [0, 1] use to set C2C data transfer between cores
  CohProtocol = [MSI, MESI, MOESI, PMSI]
  nCores = Integer number
  RunTillEnd = [0, 1] use to configure the simulator to run benchmarks till the end
  totalTimeInSeconds = number of seconds to run the simulator, configure this parameter if "RunTillEnd" = 0-->
<!-- globalQueues_en enabled by 1 or when memSystem=RROF -->
<!-- MCsim_en enabled by 1 or when globalQueues_en -->
<MCoreSimProject
	numberOfRuns="1"
	totalTimeInSeconds="1"
	RunTillEnd="1"
	busClkNanoSec="100"
	nCores="4"
	llc_nbnk="1"
	cpuFIFOSize="500"
	busFIFOSize="500"
	Cache2Cache="1"
	CohProtocol="MSI"
	loggerPath ="../log/oct/"
	logFileGenEnable  = "1"
	globalQueues_en="1"
	llcPartition="NoPartition"
	OutOfOrderStages="16">

  <InterConnect>
    <L1BusCnfg
    	busClkNanoSec="100"
    	busClkSkew="0"
    	BusArch="split"
    	BusArb="FRFCFS"
    	ReqBusArb="FRFCFS"
    	RespBusArb="FRFCFS"
    	ReqBusLat="2"
    	RespBusLat="5"
    	WrkConserv="1">
    </L1BusCnfg>
  </InterConnect>

  <privateCaches>
    <privateCache
    	cacheId="0"
    	cpuClkNanoSec="100"
    	cpuClkSkew="0"
    	ctrlClkNanoSec="100"
    	ctrlClkSkew="40"
    	NPendReq="16"
    	reqWbRatio= "1"
    	ReplcPolc= "RANDOM"
		memArb= "RROF"
		llc_nbnk="1"
    	blockSize="64"
    	cacheSize="524288"
    	mapping="0"
    	nways="4"
		dataAccessLatency="0"
		>
    </privateCache>
    <privateCache
    	cacheId="1"
    	cpuClkNanoSec="100"
    	cpuClkSkew="0"
    	ctrlClkNanoSec="100"
    	ctrlClkSkew="40"
    	NPendReq="16"
    	reqWbRatio= "1"
    	ReplcPolc= "RANDOM"
		memArb= "RROF"
		llc_nbnk="1"
    	blockSize="64"
    	cacheSize="524288"
    	mapping="0"
    	nways="4"
		dataAccessLatency="0"
		>
    </privateCache>
    <privateCache
    	cacheId="2"
    	cpuClkNanoSec="100"
    	cpuClkSkew="0"
    	ctrlClkNanoSec="100"
    	ctrlClkSkew="40"
    	NPendReq="16"
    	reqWbRatio= "1"
    	ReplcPolc= "RANDOM"
		memArb= "RROF"
		llc_nbnk="1"
    	blockSize="64"
    	cacheSize="524288"
    	mapping="0"
    	nways="4"
		dataAccessLatency="0"
		>
    </privateCache>
    <privateCache
    	cacheId="3"
    	cpuClkNanoSec="100"
    	cpuClkSkew="0"
    	ctrlClkNanoSec="100"
    	ctrlClkSkew="40"
    	NPendReq="16"
    	reqWbRatio= "1"
    	ReplcPolc= "RANDOM"
		memArb= "RROF"
		llc_nbnk="1"
    	blockSize="64"
    	cacheSize="524288"
    	mapping="0"
    	nways="4"
		dataAccessLatency="0"
		>
    </privateCache>
  </privateCaches>
  <sharedCaches>
    <sharedCache
    	cacheId="50"
    	cpuClkMHz="100"
    	cpuClkSkew="60"
    	ctrlClkMHz="100"
    	ctrlClkSkew="50"
    	NPendReq="1600"
    	ReplcPolc= "LRU"
		memArb= "RROF"
		llc_nbnk="1"
    	blockSize="64"
    	cacheSize="524288"
    	mapping="1"
    	nways="8"
    	CachePreLoad="1"
		dataAccessLatency="10"
		>
    </sharedCache>
  </sharedCaches>
  <DRAMCnfg
       DRAMId="100"
       ctrlClkMHz="100"
       ctrlClkSkew="0"
	   MEMLATENCY="250"
       MCSIM_EN="1"
	   MCSIM_Gen="DDR4"
	   MCSIM_SPEED="2400U"
	   MCSIM_SIZE="8Gb_x8"
	   MCSIM_CHANNEL="1"
	   MCSIM_RANK="1"
	   MCSIM_CPUFREQ="2.4"
	   MCSIM_ARBITER  ="RROF"
	   MCSIM_PATH    =".."
       MEMOutsandingReqs="16"
	   >
  </DRAMCnfg>
</MCoreSimProject>
