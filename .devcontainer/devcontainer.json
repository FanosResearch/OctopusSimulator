{
  "name": "Octopus tutorial",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",

  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },

  // The visualizer serves on 8765 (octoviz.sh).
  //
  // openBrowser, not openPreview: a forwarded port is private, so the first request
  // is redirected to github.com to pick up an auth cookie. The editor's preview pane
  // is an iframe, and github.com sends X-Frame-Options: DENY -- which the viewer sees
  // as "github.com refused to connect". A real browser tab already has the session,
  // so the redirect succeeds and the visualizer loads.
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "octoviz", "onAutoForward": "openBrowser" }
  },

  // onCreate: the slow, network-bound part (packages, benchmark traces). It runs
  // during a prebuild, so an attendee creating a codespace never pays for it.
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  // postCreate: the part that depends on the checked-out source. Runs once, on create
  // or on a container rebuild.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // postStart: runs on every start, including after a stop/resume where postCreate does
  // not. It rebuilds only if the binary is missing, so an interrupted create or a
  // cancelled build repairs itself instead of failing later with "No such file".
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
