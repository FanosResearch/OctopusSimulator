{
  "name": "Octopus Development Container",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "hostRequirements": {
    "cpus": 8,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "ms-python.debugpy",
        "ms-python.isort",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.makefile-tools",
        "ms-vscode-remote.remote-containers",
        "Tsinghua-Hexin-Joint-Institute.gem5-slicc"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/actionlint:1": {},
    "ghcr.io/devcontainers-extra/features/vscode-cli:1": {}
  },
  "forwardPorts": [
    8765,
    8770
  ],
  "portsAttributes": {
    "8765": {
      "label": "Octoviz trace viewer",
      "onAutoForward": "openBrowser"
    },
    "8770": {
      "label": "Octopus live demo",
      "onAutoForward": "openBrowser"
    }
  },
  "onCreateCommand": "./.devcontainer/on-create.sh"
}
